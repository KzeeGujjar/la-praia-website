# This project runs on Next.js (see CLAUDE.md), not Vite — Next.js exposes
# browser-visible env vars via the NEXT_PUBLIC_ prefix, the equivalent of
# Vite's VITE_ prefix. As with VITE_, anything prefixed NEXT_PUBLIC_ is
# bundled into client-side JavaScript and publicly visible. Never put
# secrets or API keys here.

# Absolute site URL, used for canonical links and Open Graph/Twitter tags.
# Set this once the site has a real domain; defaults to a placeholder otherwise.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-side only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Required by src/app/api/chat/route.ts, the AI chat widget's backend.
# Get a key at https://console.anthropic.com/ and set it in your hosting
# provider's environment variables — never commit a real key to this file.
ANTHROPIC_API_KEY=
