# This project runs on Next.js (see CLAUDE.md), not Vite — Next.js exposes
# browser-visible env vars via the NEXT_PUBLIC_ prefix, the equivalent of
# Vite's VITE_ prefix. As with VITE_, anything prefixed NEXT_PUBLIC_ is
# bundled into client-side JavaScript and publicly visible. Never put
# secrets or API keys here.

# Absolute site URL, used for canonical links and Open Graph/Twitter tags.
# Set this once the site has a real domain; defaults to a placeholder otherwise.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-side only (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Required by src/app/api/chat/route.ts, the AI chat widget's backend.
# Get a key at https://console.anthropic.com/ and set it in your hosting
# provider's environment variables — never commit a real key to this file.
ANTHROPIC_API_KEY=

# --- Backend (see CLAUDE.md's "Backend" section) ---

# Postgres connection string used by Prisma (see prisma/schema.prisma).
# Create a free project at https://supabase.com/, then copy the connection
# string from Project Settings -> Database -> Connection string (URI, use the
# "Transaction" pooler mode for serverless hosts like Vercel).
DATABASE_URL=

# Secret used to sign short-lived JWT access tokens (src/lib/auth/tokens.ts).
# Generate one with: openssl rand -base64 32
JWT_ACCESS_SECRET=

# One-time bootstrap for the first SUPER_ADMIN account, read by prisma/seed.ts.
# Set these, run `npm run db:seed`, then you can remove SUPER_ADMIN_PASSWORD —
# the seed script only creates the account if no user with this email exists yet.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Menu item photo uploads (src/lib/storage.ts, POST /api/admin/menu/items/:id/image).
# Same Supabase project as DATABASE_URL works fine — this just needs its Storage
# feature turned on. In the Supabase dashboard: Storage -> New bucket -> name it
# "menu-images" (or set SUPABASE_STORAGE_BUCKET to whatever you name it) and mark
# it Public, so uploaded photos are viewable without extra signing. Then:
# Project Settings -> API -> "Project URL" and the "service_role" secret key
# (NOT the "anon" public key — service_role bypasses bucket policies so the
# server can upload on the admin's behalf; never expose it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=menu-images
